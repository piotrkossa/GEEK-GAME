    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[29].answerC
      value: "Nie sprawdza\u0107 nic, bo ka\u017Cda strona jest bezpieczna"
