    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[0].questionText
      value: "Twoja baza zosta\u0142a zaatakowana przez haker\xF3w. Co powiniene\u015B
        zrobi\u0107 jako pierwszy? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[1].questionText
      value: "Twoje urz\u0105dzenie zosta\u0142o zainfekowane z\u0142o\u015Bliwym
        oprogramowaniem. Jak je usun\u0105\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[2].questionText
      value: 'Widzisz podejrzany link w e-mailu od nieznajomego. Co robisz? '
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[3].questionText
      value: "Zabezpieczasz has\u0142o do swojego konta. Co powinno by\u0107 najlepsz\u0105
        praktyk\u0105? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[4].questionText
      value: "Pr\xF3bujesz logowa\u0107 si\u0119 do swojego konta, ale widzisz, \u017Ce
        has\u0142o nie dzia\u0142a. Co robisz? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[5].questionText
      value: "Twoje urz\u0105dzenie jest atakowane przez ransomware. Co powiniene\u015B
        zrobi\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[6].questionText
      value: "Jakie zachowanie mo\u017Ce pom\xF3c w zapobieganiu phishingowi? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[7].questionText
      value: "Co mo\u017Ce by\u0107 oznak\u0105 ataku typu DDoS? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[8].questionText
      value: "Co jest najcz\u0119\u015Bciej wykorzystywan\u0105 metod\u0105 atak\xF3w
        na sieci Wi-Fi? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[9].questionText
      value: "Jak\u0105 funkcj\u0119 pe\u0142ni zapora sieciowa (firewall)? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[10].questionText
      value: "Twoje konto bankowe zosta\u0142o przej\u0119te przez cyberprzest\u0119pc\xF3w.
        Jakie powinno by\u0107 pierwsze dzia\u0142anie? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[11].questionText
      value: "Zauwa\u017Cy\u0142e\u015B podejrzane logowanie na swoim koncie. Co
        robisz? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[12].questionText
      value: "Jaki typ ataku na stron\u0119 WWW jest najcz\u0119\u015Bciej wykorzystywany
        do wykradania danych? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[13].questionText
      value: "Co to jest \u201Espoofing\u201D w kontek\u015Bcie cyberbezpiecze\u0144stwa? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[14].questionText
      value: "Co oznacza poj\u0119cie \u201Edwusk\u0142adnikowe uwierzytelnianie\u201D? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[15].questionText
      value: "Twoja sie\u0107 jest atakowana przez tzw. \u201Eman-in-the-middle\u201D
        (MITM). Jakie jest najlepsze rozwi\u0105zanie? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[16].questionText
      value: "Zgadzasz si\u0119 na warunki us\u0142ugi na nowej stronie. Co powinno
        ci\u0119 zaniepokoi\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[17].questionText
      value: "Twoje konto zosta\u0142o zaatakowane przez trojana. Co powiniene\u015B
        zrobi\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[18].questionText
      value: "Co to jest \u201Ekeylogger\u201D? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[19].questionText
      value: "Twoja sie\u0107 jest pe\u0142na urz\u0105dze\u0144. Jak najlepiej zabezpieczy\u0107
        j\u0105 przed atakami? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[20].questionText
      value: "Co to jest \u201Esocial engineering\u201D w kontek\u015Bcie cyberbezpiecze\u0144stwa? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[21].questionText
      value: "Co oznacza termin \u201Ezero-day exploit\u201D? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[22].questionText
      value: "Dlaczego regularnie aktualizowanie systemu operacyjnego jest wa\u017Cne? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[23].questionText
      value: "Kiedy powinno si\u0119 u\u017Cywa\u0107 VPN? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[24].questionText
      value: "Co to jest \u201Ecyberhigiena\u201D? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[25].questionText
      value: "Co to jest \u201Crootkit\u201D? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[26].questionText
      value: "Twoja sie\u0107 zosta\u0142a zaatakowana przez ransomware. Co musisz
        zrobi\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
