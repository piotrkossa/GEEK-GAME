      value: 'Co to jest "cryptojacking"? '
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[28].questionText
      value: "Jakie zabezpieczenie jest najskuteczniejsze w przypadku publicznych
        komputer\xF3w? "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[29].questionText
      value: "Jakie informacje nale\u017Cy sprawdza\u0107 przy ocenie wiarygodno\u015Bci
