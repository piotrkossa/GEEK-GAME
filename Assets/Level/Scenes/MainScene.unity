    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[29].answerA
      value: "Sprawdzi\u0107 certyfikat SSL i upewni\u0107 si\u0119, \u017Ce strona
        zaczyna si\u0119 od \"https://\" "
