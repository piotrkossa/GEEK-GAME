    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[29].answerB
      value: "Sprawdzi\u0107 tylko wygl\u0105d strony i liczb\u0119 reklam "
