    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[27].answerB
      value: "Atak polegaj\u0105cy na wykorzystaniu komputer\xF3w do kopania kryptowalut
        bez zgody w\u0142a\u015Bciciela "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[27].answerC
      value: "Z\u0142o\u015Bliwe oprogramowanie do przechwytywania hase\u0142 w grach
        online "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[28].answerA
      value: "Zawsze u\u017Cywa\u0107 prywatnego trybu przegl\u0105darki "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[28].answerB
      value: "Zalogowa\u0107 si\u0119 na swoje konto Google "
      objectReference: {fileID: 0}
    - target: {fileID: 4133397480334145518, guid: 874ce298f20142c46b55360b822907ce, type: 3}
      propertyPath: question.Array.data[28].answerC
      value: "Zawsze wylogowa\u0107 si\u0119 z wszystkich aplikacji po zako\u0144czeniu
